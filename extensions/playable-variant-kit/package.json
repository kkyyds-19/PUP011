{
  "package_version": 2,
  "version": "1.1.0",
  "name": "playable-variant-kit",
  "description": "Reusable multi-variant playable redirect runtime and one-click packager.",
  "main": "./main.js",
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension",
        "label": "Playable Variant Kit/安装或更新场景组件",
        "message": "install-runtime"
      },
      {
        "path": "i18n:menu.extension",
        "label": "Playable Variant Kit/一键导出全部版本",
        "message": "package-variants"
      }
    ],
    "messages": {
      "install-runtime": {
        "methods": [
          "installRuntime"
        ]
      },
      "package-variants": {
        "methods": [
          "packageVariants"
        ]
      }
    }
  },
  "editor": ">=3.8.0"
}
